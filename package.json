{
  "name": "@zamn/acme-uat-sdk",
  "version": "1.0.0",
  "description": "",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.js",
  "unpkg": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest",
    "build": "tsup-node src/index.ts src/api/resources/widgets/index.ts --format cjs,esm --clean && tsc --project tsconfig.types.json && node -e \"const fs=require('fs');const path=require('path');function fx(s,d){const dir=path.dirname(s);const c=fs.readFileSync(s,'utf8');const p=c.replace(/((?:from|import)\\s*\\(?\\s*[\\x27\\x22])(\\.\\.?\\/[^\\x27\\x22]+?)([\\x27\\x22])/g,(m,a,b,e)=>{if(/\\.[a-zA-Z0-9]+$/.test(b))return m;const suffix=fs.existsSync(path.join(dir,b)+'.d.ts')?'.js':'/index.js';return a+b+suffix+e});fs.writeFileSync(d,p)};fx('dist/index.d.ts','dist/index.d.mts');fx('dist/api/resources/widgets/index.d.ts','dist/api/resources/widgets/index.d.mts')\"",
    "format": "biome format --write --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
    "format:check": "biome format --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
    "lint": "biome lint --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
    "lint:fix": "biome lint --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
    "check": "biome check --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
    "check:fix": "biome check --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
    "prepublishOnly": "chmod +x ./scripts/prepublish.sh && ./scripts/prepublish.sh && npm run build",
    "test-example": "cd examples && tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "sdk",
    "api",
    "client"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "",
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.14.0",
    "tsup": "^6.7.0",
    "vitest": "^3.2.4",
    "@biomejs/biome": "2.4.10",
    "webpack": "^5.105.4",
    "ts-loader": "^9.5.4"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./widgets": {
      "require": {
        "types": "./dist/api/resources/widgets/index.d.ts",
        "default": "./dist/api/resources/widgets/index.js"
      },
      "import": {
        "types": "./dist/api/resources/widgets/index.d.mts",
        "default": "./dist/api/resources/widgets/index.mjs"
      },
      "default": "./dist/api/resources/widgets/index.js"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
